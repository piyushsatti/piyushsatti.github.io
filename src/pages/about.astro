---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechStack from "../components/TechStack.astro";
import Timeline from "../components/Timeline.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

// Education timeline data
const education = [
  {
    title: "Master of Applied Computer Science",
    institution: "Concordia University",
    startDate: "Sept 2023",
    endDate: "Aug 2025",
    description: "Montreal, Quebec, Canada",
    details: [],
    links: [],
  },
  {
    title: "B.E. Electronics & Computer Engineering",
    institution: "Thapar Institute of Engineering and Technology",
    startDate: "Jun 2017",
    endDate: "Jun 2021",
    description: "Patiala, Punjab, India",
    details: [],
    links: [],
  },
];

---

<BaseLayout title="About Me">
  <div class="index-content framed">
    <h1>About Me</h1>
    <p>
      I'm Piyush Satti, a Python developer in Montreal working on data
      pipelines and computer vision. At Citylogix I work on a pipeline that
      processes road-survey imagery and build training-data tooling with the AI
      team.
    </p>
    <p>
      Before that I did a Master of Applied Computer Science at Concordia, and I
      have <a href={`${base}research/`}>six peer-reviewed papers</a> on image
      restoration, five as first author.
    </p>
    <p>
      Outside work I build open-source tools for coding with agents, mostly
      around keeping context when a long chat gets summarized. A couple of them
      are <a
        href="https://github.com/piyushsatti/observational-memory"
        target="_blank"
        rel="noopener noreferrer">observational-memory</a
      > (a port of elpapi42/pi-observational-memory) and <a
        href="https://github.com/piyushsatti/weave"
        target="_blank"
        rel="noopener noreferrer">weave</a
      > (a plugin compiler, now frozen). I write about building them, and about
      my home lab, on the blog.
    </p>
    <p>
      I love software, I spent a few years in game design, and I'm an avid
      hiker.
    </p>
    <p>
      <a
        href="https://github.com/piyushsatti"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      > ::
      <a
        href="https://www.linkedin.com/in/piyushsatti/"
        target="_blank"
        rel="noopener noreferrer">LinkedIn</a
      > ::
      <a
        href="https://scholar.google.ca/citations?user=eR10c10AAAAJ&hl=en"
        target="_blank"
        rel="noopener noreferrer">Scholar</a
      >
    </p>
  </div>

  <figure>
    <img
      src={`${base}og-images/background.gif`}
      alt="Terminal Pi(π) Animation"
      loading="lazy"
    />
    <figcaption>Fueled by: diet coke, whiteclaw, and ramen.</figcaption>
  </figure>

  <TechStack
    idPrefix="about"
    title="Technical Skills"
    subtitle="Filter by language, stack, and focus area."
  />

  <Timeline title="Education" items={education} />

  <p><a href={`${base}courses/`}>Coursework</a></p>
</BaseLayout>
