---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechStack from "../components/TechStack.astro";
import Timeline from "../components/Timeline.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

// Education timeline data
const education = [
  {
    title: "Master of Applied Computer Science",
    institution: "Concordia University",
    startDate: "Sept 2023",
    endDate: "Aug 2025",
    description: "Montreal, Quebec, Canada",
    details: [],
    links: [],
  },
  {
    title: "B.E. Electronics & Computer Engineering",
    institution: "Thapar Institute of Engineering and Technology",
    startDate: "Jun 2017",
    endDate: "Jun 2021",
    description: "Patiala, Punjab, India",
    details: [],
    links: [],
  },
];

---

<BaseLayout title="About Me">
  <div class="index-content framed">
    <h1>About Me</h1>
    <p>
      I'm a backend-leaning developer with a Master of Applied Computer Science
      from Concordia University. I care about typed schemas,
      clean boundaries, and tests that read like specs.
    </p>
    <p>
      <a
        href="https://github.com/piyushsatti"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      > ::
      <a
        href="https://www.linkedin.com/in/piyush-satti/"
        target="_blank"
        rel="noopener noreferrer">LinkedIn</a
      > ::
      <a
        href="https://scholar.google.ca/citations?user=eR10c10AAAAJ&hl=en"
        target="_blank"
        rel="noopener noreferrer">Scholar</a
      >
    </p>
  </div>

  <figure>
    <img
      src={`${base}og-images/background.gif`}
      alt="Terminal Pi(π) Animation"
      loading="lazy"
    />
    <figcaption>Fueled by: diet coke, whiteclaw, and ramen.</figcaption>
  </figure>

  <TechStack
    idPrefix="about"
    title="Technical Skills"
    subtitle="Filter by language, stack, and focus area."
  />

  <Timeline title="Education" items={education} />

  <p><a href={`${base}courses/`}>Coursework</a></p>
</BaseLayout>
